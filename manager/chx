#!/bin/bash

CMD="$1"
PKG="$2"

case "$CMD" in
  install)
    if [ -z "$PKG" ]; then
      echo "Usage: chx install <package.chx>"
      exit 1
    fi

    APPNAME=$(basename "$PKG" .chx)
    DEST="$HOME/.chimo-apps/$APPNAME"

    echo "📦 Installing $APPNAME in $DEST..."
    mkdir -p "$DEST"
    tar -xzf "$PKG" -C "$DEST"

    # Auto‑fix duplicate folder structure
    INNER="$DEST/$APPNAME"
    if [ -d "$INNER/src" ]; then
      echo "⚠️ Fixing duplicate folder structure..."
      mv "$INNER/"* "$DEST/"
      rm -rf "$INNER"
    fi

    # Create virtual environment
    echo "🐍 Creating virtual environment..."
    python3 -m venv "$DEST/venv"

    # Install dependencies
    echo "📚 Installing dependencies..."
    source "$DEST/venv/bin/activate"
    if [ -f "$DEST/requirements.txt" ]; then
      pip install -r "$DEST/requirements.txt"
    fi
    deactivate

    # Create desktop shortcut
    echo "🖥️ Creating desktop shortcut..."
    mkdir -p "$HOME/.local/share/applications"
    cat > "$HOME/.local/share/applications/$APPNAME.desktop" << EOF
[Desktop Entry]
Name=$APPNAME
Exec=$DEST/venv/bin/python $DEST/src/main.py
Icon=$DEST/assets/icon.png
Type=Application
Categories=Utility;
EOF

    update-desktop-database ~/.local/share/applications

    echo "✅ Installation complete. Launch '$APPNAME' from your menu."
    ;;

  remove)
    if [ -z "$PKG" ]; then
      echo "Usage: chx remove <appname>"
      exit 1
    fi

    APPNAME="$PKG"
    DEST="$HOME/.chimo-apps/$APPNAME"

    echo "🗑️ Removing $APPNAME..."
    rm -rf "$DEST"
    rm -f "$HOME/.local/share/applications/$APPNAME.desktop"
    update-desktop-database ~/.local/share/applications
    echo "✅ $APPNAME removed."
    ;;

  register-global)
    echo "🌍 Registering CHX globally..."

    # MIME type
    sudo tee /usr/share/mime/packages/chx.xml > /dev/null << EOF
<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-chimo">
    <comment>CHX Package</comment>
    <glob pattern="*.chx"/>
  </mime-type>
</mime-info>
EOF
    sudo update-mime-database /usr/share/mime

    # Global desktop entry
    sudo tee /usr/share/applications/chx-installer.desktop > /dev/null << EOF
[Desktop Entry]
Name=CHX Installer
Comment=Graphical installer for CHX packages
Exec=/usr/local/bin/chx install %f
Icon=system-software-install
Terminal=false
Type=Application
MimeType=application/x-chimo;
Categories=System;Utility;
EOF
    sudo update-desktop-database /usr/share/applications

    echo "✅ Global registration complete. Double‑click any .chx file to install."
    ;;

  *)
    echo "Usage: chx <install|remove|register-global> <package.chx|appname>"
    ;;
esac
